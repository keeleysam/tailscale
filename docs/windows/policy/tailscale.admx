    <policy name="MachineCertificateSubject" class="Machine" displayName="$(string.MachineCertificateSubject)" explainText="$(string.MachineCertificateSubject_Help)" presentation="$(presentation.MachineCertificateSubject)" key="Software\Policies\Tailscale">
