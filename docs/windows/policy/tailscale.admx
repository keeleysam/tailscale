<?xml version="1.0" encoding="UTF-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="tailscale" namespace="Tailscale.Policies"></target>
  </policyNamespaces>
  <resources minRequiredRevision="1.0"></resources>
  <supportedOn>
    <products>
      <product name="TAILSCALE_PRODUCT" displayName="$(string.TAILSCALE_PRODUCT)">
        <majorVersion name="TAILSCALE_V1" displayName="$(string.TAILSCALE_PRODUCT)" versionIndex="1"></majorVersion>
      </product>
    </products>
    <definitions>
      <definition name="SUPPORTED_ALL" displayName="$(string.SUPPORTED_ALL)">
        <and>
          <reference ref="TAILSCALE_PRODUCT"></reference>
        </and>
      </definition>
    </definitions>
  </supportedOn>
  <categories>
    <category name="Top_Category" displayName="$(string.Tailscale_Category)"></category>
    <category name="AutoUpdate_Category" displayName="$(string.AutoUpdate_Category)">
      <parentCategory ref="Top_Category"></parentCategory>
    </category>
    <category name="ExitNode_Category" displayName="$(string.ExitNode_Category)">
      <parentCategory ref="Top_Category"></parentCategory>
    </category>
    <category name="Organization_Category" displayName="$(string.Organization_Category)">
      <parentCategory ref="Top_Category"></parentCategory>
    </category>
    <category name="Runtime_Category" displayName="$(string.Runtime_Category)">
      <parentCategory ref="Top_Category"></parentCategory>
    </category>
    <category name="UIVisibility_Category" displayName="$(string.UIVisibility_Category)">
      <parentCategory ref="Top_Category"></parentCategory>
    </category>
  </categories>
  <policies>
    <policy name="AdminConsole" class="Both" displayName="$(string.AdminConsole)" explainText="$(string.AdminConsole_Help)" key="Software\Policies\Tailscale" valueName="AdminConsole">
      <parentCategory ref="UIVisibility_Category"></parentCategory>
      <supportedOn ref="SUPPORTED_ALL"></supportedOn>
      <enabledValue>
        <string>show</string>
      </enabledValue>
      <disabledValue>
        <string>hide</string>
      </disabledValue>
    </policy>
    <policy name="AdvertiseExitNode" class="Machine" displayName="$(string.AdvertiseExitNode)" explainText="$(string.AdvertiseExitNode_Help)" key="Software\Policies\Tailscale" valueName="AdvertiseExitNode">
      <parentCategory ref="ExitNode_Category"></parentCategory>
      <supportedOn ref="SUPPORTED_ALL"></supportedOn>
      <enabledValue>
        <string>always</string>
      </enabledValue>
      <disabledValue>
        <string>never</string>
      </disabledValue>
    </policy>
    <policy name="AllowIncomingConnections" class="Machine" displayName="$(string.AllowIncomingConnections)" explainText="$(string.AllowIncomingConnections_Help)" key="Software\Policies\Tailscale" valueName="AllowIncomingConnections">
