        </textBox>
      </presentation>
      <presentation id="KeyExpirationNotice">
        <textBox refId="KeyExpirationNotice">
          <label>Key expiration notice:</label>
        </textBox>
      </presentation>
      <presentation id="LogTarget">
        <textBox refId="LogTarget">
          <label>Log server URL:</label>
        </textBox>
      </presentation>
      <presentation id="LoginURL">
        <textBox refId="LoginURL">
          <label>Coordination server URL:</label>
        </textBox>
      </presentation>
      <presentation id="MachineCertificateSubject">
        <textBox refId="MachineCertificateSubject">
          <label>Machine certificate subject:</label>
        </textBox>
      </presentation>
      <presentation id="ReconnectAfter">
