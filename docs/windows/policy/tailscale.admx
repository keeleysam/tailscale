    <policy name="ExitNodeIP" class="Machine" displayName="$(string.ExitNodeIP)" explainText="$(string.ExitNodeIP_Help)" presentation="$(presentation.ExitNodeIP)" key="Software\Policies\Tailscale">
      <parentCategory ref="ExitNode_Category"></parentCategory>
